# =============================================================================
# KostManager — Frontend (Next.js) — contoh environment lokal
# Salin file ini menjadi `apps/web/.env.local` lalu sesuaikan nilainya.
# Prefix NEXT_PUBLIC_ membuat nilai terekspos ke browser — jangan pernah
# menaruh secret di sini (PRD-4 §3).
# =============================================================================

# URL backend NestJS, termasuk prefix global `/api`
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# URL aplikasi ini sendiri
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Hostname bucket R2 untuk optimasi `next/image` (opsional)
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Nama yang ditampilkan pada halaman login/register sebelum auth terhubung
NEXT_PUBLIC_APP_NAME="KostManager"
