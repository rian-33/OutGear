# =============================================================================
# KostManager — Backend (NestJS) — contoh environment Supabase
# Salin file ini menjadi `apps/api/.env` lalu isi password dan secret sendiri.
# JANGAN pernah commit `.env` asli (PRD-4 §3).
# =============================================================================

# ---------------------------------------------
# Database — Supabase (Dashboard > Connect > Prisma)
# Ganti [YOUR-PASSWORD] dengan password database Supabase.
# Encode karakter khusus pada password sebagai URL encoding.
# DATABASE_URL: shared transaction-mode pooler (port 6543).
# DIRECT_URL: shared session-mode pooler (port 5432), untuk migrasi Prisma.
# ---------------------------------------------
DATABASE_URL="postgresql://postgres.flbrqyytleoaxssbunev:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.flbrqyytleoaxssbunev:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Redis opsional. Biarkan kosong jika Redis lokal tidak dijalankan.
REDIS_URL=""

# JWT — ganti kedua nilai dengan secret acak minimal 32 karakter.
JWT_ACCESS_SECRET="ganti-dengan-secret-access-minimal-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-secret-refresh-minimal-32-karakter"
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="2592000"

# Cloudflare R2 — opsional untuk upload bukti pembayaran.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="kostmanager-bukti"
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# Rate limit login.
AUTH_RATE_LIMIT_TTL_MS="60000"
AUTH_RATE_LIMIT_MAX="5"

# Seed — akun admin development, dibuat oleh prisma:seed. Ganti sebelum production.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_EMAIL="admin@kostmanager.local"
SEED_ADMIN_NAMA="Administrator Kos"
SEED_ADMIN_NO_HP="08123456789"

# Umum.
NODE_ENV="development"
TZ="Asia/Makassar"
PORT="3000"
CORS_ORIGIN="http://localhost:3001"


